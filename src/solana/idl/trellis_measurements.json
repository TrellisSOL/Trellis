      "name": "PendingAuthority",
      "docs": [
        "An authority hand-over waiting for the new authority to accept after `CONFIG_TIMELOCK`. PDA `[\"pending_authority\"]`."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "new_authority",
