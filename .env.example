# ---- Core ------------------------------------------------------------------------------
TRELLIS_ENV=development            # development | test | production
# The launch surface. core (the default): only the routes and background jobs on the allow-list exist
# (src/surface/core-allowlist.ts: chat, completions, embeddings, models, keys, credits, x402, receipts, attestation,
# status, the dashboard); every other route answers 404 not_enabled and every setting below that switches another
# feature on is ignored (and refused in production). all: everything in this file works as described; in production it
# needs LAUNCH_SURFACE_ACK=i-have-reviewed-the-extra-features (see security/DEFERRED.md first).
LAUNCH_SURFACE=core
# LAUNCH_SURFACE_ACK=
# Operator routes (ADMIN_TOKEN) answer only these source addresses (IPs, IPv4 CIDR blocks), or a loopback caller when
# ADMIN_TRUST_LOOPBACK=true (off by default in production since round 5: behind a proxy that adds no forwarding
# header every request looks like loopback). The token travels in X-Admin-Token.
# ADMIN_ALLOWED_SOURCES=
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
ZKAPI_PAGE_ORIGINS=                 # Exact comma-separated HTTPS origins for /zkapi/ and its worker; empty preserves site CSP. Web build args: NEXT_PUBLIC_ZKAPI_ENABLED=false, NEXT_PUBLIC_ZKAPI_MANIFEST_URL="", NEXT_PUBLIC_ZKAPI_MANIFEST_SHA256="" (public manifest URL and SHA-256 pin).
# Passkeys for team members (WebAuthn). Default: the host and origin of PUBLIC_BASE_URL, where the dashboard is served.
# WEBAUTHN_RP_ID=trellis.example
# WEBAUTHN_ORIGINS=https://trellis.example
# pglite://.data/pglite (zero-setup, in-process Postgres) | postgres://user:pass@host:5432/trellis
DATABASE_URL=pglite://.data/pglite
# Optional: enables Redis rate limits/cache and BullMQ jobs (required for multiple replicas)
REDIS_URL=
# >= 32 chars in production. Encrypts provider/BYOK keys and receipt keys at rest.
APP_SECRET=
# Operator token for /trpc operator procedures (>= 24 chars in production)
ADMIN_TOKEN=
LOG_LEVEL=info
# Behind exactly one reverse proxy/load balancer that appends X-Forwarded-For: true. Otherwise false
# (then every client behind a proxy would share one IP for rate limits; never true without a proxy).
TRUST_PROXY=false
# Behind a trusted proxy: TRUST_PROXY=true; count appended proxy hops from the RIGHT, never the left.
TRUST_PROXY_HOPS=1
REQUEST_MAX_BYTES=1048576
MCP_MAX_BYTES=262144
ANON_RATE_PER_MIN=120
# Enable after Cloudflare overwrites X-Origin-Lock. Never give the secret to a client.
ORIGIN_LOCK_ENABLED=false
ORIGIN_LOCK_SECRET=

# ---- Solana ------------------------------------------------------------------------
# CHAIN_ID is the wallet-adapter numeric id (101 mainnet-beta, 102 testnet, 103 devnet), kept for scoping stored rows;
# SOLANA_NETWORK is the CAIP-2 name x402 and receipts publish.
CHAIN_ID=101
SOLANA_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
SOL_RPC_URL=https://api.mainnet-beta.solana.com # Private server RPC; keyed HTTPS URLs allowed, redacted from errors and logs.
SOL_RPC_FALLBACK_URLS=https://api.mainnet-beta.solana.com # Comma-separated HTTPS fallbacks; empty disables them; public-only primary uses one endpoint.
PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com # shown to wallets (never the private node URL)
EXPLORER_URL=https://explorer.solana.com
CHAIN_CONFIRMATIONS=2                 # slots past confirmed before a deposit shows as confirming
CHAIN_START_BLOCK=                    # first slot the program indexer reads
USDC_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v   # the USDC mint
# Program addresses (base58), empty until the Anchor programs are deployed. TODO(solana)
CREDITS_ADDRESS=
CALLPAY_ADDRESS=
PAYWITHSTOCK_ADDRESS=
PROVIDER_BOND_ADDRESS=
RECEIPT_ANCHOR_ADDRESS=
ROYALTY_ADDRESS=
PAYMASTER_ADDRESS=                    # fee-payer sponsorship program, if any
# Trellis Anchor programs (docs/Trellis_Backend.md §5); each wins over the older *_ADDRESS key above when both are set.
TRELLIS_CREDITS_PROGRAM_ID=
TRELLIS_TAB_PROGRAM_ID=
TRELLIS_BOND_PROGRAM_ID=
TRELLIS_ANCHOR_PROGRAM_ID=
TRELLIS_RULES_PROGRAM_ID=
TRELLIS_FEE_ROUTER_PROGRAM_ID=
TRELLIS_CAPACITY_PROGRAM_ID=
TREASURY_ADDRESS=                     # protocol treasury wallet (20% of fees)
REFUND_POOL_ADDRESS=                  # where executed slashes land before affected callers are refunded
SOLANA_RPC_URL=                       # same as SOL_RPC_URL under the name the backend doc uses; wins when set
SOLANA_COMMITMENT=confirmed           # confirmed | finalized for reads and sends; deposits are credited at finalized
TAB_CAP_USDC=500                      # pre-audit cap (§10): at most 500
CREDITS_CAP_USDC=5000                 # pre-audit cap per key (§10): at most 5000
CREDITS_REFUND_DELAY_H=72             # account-closure refunds wait the open-dispute window, then pass sanctions screening
X402_FACILITATOR_URL=                 # external x402 facilitator for `exact` (Coinbase-compatible); empty: the router settles itself
FACILITATOR_FEE_WAIVER_UNTIL=         # inert: the hosted facilitator charges no fee at any time (zero markup; FACILITATOR_FEE_BPS can only be 0)
X402_MIN_PAYMENT=0.03                 # smallest per-call x402 payment (USDC); at least three times the worst-case network fee at X402_SOL_USDC
X402_SOL_USDC=250                     # what the operator pays for SOL, in USDC: the network fee of a sponsored payment is passed through at this price, with no margin
# JSON [{"sender":"<base58>","runtimeHash":"<64 hex>"}]; reviewed immutable sponsored accounts only. Empty disables sponsorship.
PAYMASTER_ACCOUNT_RUNTIMES=[]
CALLPAY_TREASURY=
# Hot keys for operational roles (base58 64-byte ed25519 secret keys; fund with a little SOL for fees). Keep them in a secret store.
ROUTER_PRIVATE_KEY=                 # co-signs x402 payments as fee payer
SETTLEMENT_PRIVATE_KEY=             # posts spent roots, streams royalties, payouts, margin
ANCHORER_PRIVATE_KEY=               # posts receipt anchors + the signing-key registry
PAYMASTER_SIGNER_KEY=               # fee-payer sponsorship signer
SLASHER_PRIVATE_KEY=                # dev only; in production the multisig executes slashes

# ---- Economics -----------------------------------------------------------------------------
PER_CALL_MARGIN_BPS=0               # zero markup: per-call and tab payments cost exactly the host price
PROVIDER_FEE_BPS=0                  # zero markup: hosts are paid their full price
BYOK_FEE_BPS=0
PER_CALL_MAX_USD=25
PER_CALL_QUOTE_TTL_S=300
# x402 (exact scheme): agents sign a USDC transfer to X402_PAY_TO and send it as X-PAYMENT; the router co-signs it as
# fee payer (ROUTER_PRIVATE_KEY, funded with a little SOL) and serves the call. Needs no program.
# On when X402_PAY_TO is set to a wallet the operator controls (it is not a program account that indexes deposits).
X402_PAY_TO=
X402_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp        # CAIP-2 network advertised in `accepts`
# x402 payment recovery: a paid answer is kept sealed in Redis for 24 hours so a payer who lost it can have it sent again
# (PAYMENT-RECOVERY) instead of paying twice. Add `x402-recovery-expire` to WORKER_JOBS on the worker role to delete the
# rows and sealed answers once their 24 hours have passed.
# Make-good refunds (/docs/#make-good-refunds): failed, cut-off, rerouted and unattested calls refunded by fixed rules.
MAKEGOOD_ENABLED=false
# Treasury key that sends on-chain refunds to per-call payers. Production: only on the worker that runs `makegood-payouts`,
# with no other signing key. Unset: those refunds stay owed (GET /api/v1/status, makegood.onchain).
MAKEGOOD_REFUND_PRIVATE_KEY=

# ---- Paid tool market (v6 T): keys pay any x402 tool from their balance ------------------------
# The router pays the seller from TOOLS_BUYER_PRIVATE_KEY (a dedicated wallet holding USDC, never another role key) and
# charges the key the tool price (plus TOOLS_TAKE_BPS, default 0). Off by default; /api/v1/status shows tools.ready.
TOOLS_MARKET_ENABLED=false
TOOLS_TAKE_BPS=0
TOOLS_BUYER_PRIVATE_KEY=
TOOLS_MAX_PRICE_USD=5               # most one call may charge a key, whatever max_price says
TOOLS_DAILY_LIMIT_USD=100           # most the buyer wallet authorizes per rolling 24 hours, all keys and canaries together
TOOLS_MAX_RESPONSE_BYTES=2097152
TOOLS_PUBLIC_CATALOG_URL=           # optional public x402 catalog (Bazaar discovery shape) searched next to local listings
TOOLS_PUBLIC_CATALOG_TTL_S=900
TOOLS_CANARY_INTERVAL_MS=86400000   # one paid known-answer probe per listed tool per day; 3 failures in a row delist it
TOOLS_CANARY_MAX_PRICE_USD=0.05

# ---- Pay with tokens (not ported to Solana yet; sessions answer 410) -----------------------------
# JSON list of accepted SPL tokens [{symbol,address (mint),decimals,feed (price feed account)}]
PAYWITH_TOKENS=
PAYWITH_THRESHOLD_USD=1
PAYWITH_MAX_AGE_H=24
PAYWITH_MAX_DEBT_USD=5
PAYWITH_MAX_SLIP_BPS=100
PAYWITH_CAP_HAIRCUT_BPS=1000

# ---- Token escrow payments (PAYMENTS_MODE=escrow; indexer not ported to Solana yet) -------------
# Customers sign in with their wallet and transfer a listed SPL token to ESCROW_ADDRESS (a wallet
# you control; only its public address goes here). Once the transfer's slot is finalized (ESCROW_FINALITY,
# with CHAIN_CONFIRMATIONS as an extra floor), the sending wallet's account is credited at the feed price
# minus ESCROW_HAIRCUT_BPS; until then it shows as pending_finality.
# On Solana `finalized` trails the head by about 13 seconds and `confirmed` by about half a second.
# Credits are re-verified for ESCROW_REORG_HORIZON_BLOCKS slots; one whose transfer is no longer found
# is reversed and flagged until escrow_deposits.reviewed_at is set.
# Runs without the Trellis programs, which must then be left unset. Set ESCROW_START_BLOCK to the
# slot at or before the escrow address was first published, so no earlier transfer is missed.
PAYMENTS_MODE=contracts
ESCROW_ADDRESS=
# JSON [{symbol,address,decimals,feed}]; empty = the PAYWITH_TOKENS entries that have a feed
ESCROW_TOKENS=
ESCROW_HAIRCUT_BPS=300
ESCROW_MAX_PRICE_AGE_S=302400
ESCROW_START_BLOCK=
ESCROW_FINALITY=finalized
ESCROW_REORG_HORIZON_BLOCKS=216000      # ~1 day of slots

# ---- Pay with $TRLS in escrow (off unless TRLS_TOKEN_ADDRESS is set) --------------------------
# TRLS sent to ESCROW_ADDRESS is credited to the sending wallet (same finality and idempotency rules as
# any listed token). It has no feed: the router takes its own reading of the token's market once every
# TRLS_PRICE_SAMPLE_SECONDS from finalized account state (the launch curve, or the pool TRLS_POOL_VAULTS
# names), in dollars through the on-chain SOL/USD price account, and credits a deposit at the LOWEST
# reading of the last TRLS_PRICE_WINDOW_MINUTES. No price while the window is not covered
# (TRLS_PRICE_MIN_COVERAGE of its readings), the market holds less than TRLS_PRICE_MIN_SOL, or the SOL
# price is older than two minutes: the deposit then waits as `pending` (stage `awaiting_price`;
# GET /api/v1/escrow/trls/price says why).
# TRLS_TOKEN_DECIMALS and the mint's extensions are checked before anything is credited.
# One deposit is credited at most TRLS_ESCROW_MAX_USD_PER_DEPOSIT, and all deposits of 24 hours together
# at most TRLS_ESCROW_MAX_USD_PER_DAY (a deposit past it waits). What a credited deposit paid is burned
# by the worker that holds TRLS_BURN_PRIVATE_KEY (the key of ESCROW_ADDRESS) and runs the trls-burn job.
TRLS_TOKEN_ADDRESS=
TRLS_TOKEN_SYMBOL=TRLS
TRLS_TOKEN_DECIMALS=9
TRLS_ESCROW_HAIRCUT_BPS=0                # vs ESCROW_HAIRCUT_BPS for listed tokens
TRLS_ESCROW_MAX_USD_PER_DEPOSIT=250
TRLS_ESCROW_MAX_USD_PER_DAY=100
TRLS_POOL_VAULTS=                        # JSON {"base":"<pool's TRLS token account>","quote":"<pool's wrapped-SOL token account>"}; empty = the launch curve
TRLS_PRICE_WINDOW_MINUTES=30
TRLS_PRICE_SAMPLE_SECONDS=60
TRLS_PRICE_MIN_COVERAGE=0.75
TRLS_PRICE_MIN_SOL=10
TRLS_BURN_PRIVATE_KEY=                   # a worker's, never the API's
TRLS_BURN_FEE_PAYER=escrow               # or anchorer: the anchorer key pays the burn's network fee

# ---- Add funds with USDC in escrow (off unless USDC_ESCROW_ENABLED) ------------------------------
# USDC (USDC_ADDRESS) sent to ESCROW_ADDRESS is credited to the sending wallet 1:1 at par: balances are
# USDC-denominated, so no feed or pool is read. Same finality, reorganization, idempotency and reversal
# rules as listed tokens and TRLS, and the same fast credit (FAST_CREDIT_*) where that is switched on.
# USDC has 6 decimals; the mint is checked before anything is credited. One deposit is credited
# at most USDC_ESCROW_MAX_USD_PER_DEPOSIT (after the haircut); anything above is not credited and the
# deposit is flagged for operator review, as for TRLS. Every USDC transfer into ESCROW_ADDRESS counts, so
# keep that wallet for customer deposits only (X402_PAY_TO must be a different address).
# GET /api/v1/status reports escrow.usdc.
USDC_ESCROW_ENABLED=false
USDC_ESCROW_HAIRCUT_BPS=0                # vs ESCROW_HAIRCUT_BPS for listed tokens
USDC_ESCROW_MAX_USD_PER_DEPOSIT=1000

# ---- $TRLS holder perks (the token is TRLS_TOKEN_ADDRESS above) ---------------------------------
# Membership tiers read from the wallet's token balance (cached 1 hour; no tier when the RPC fails) for calls made
# with wallet sign-in keys, paid per call by a wallet, or billed to a tab. Tiers are fixed thresholds: nothing scales
# with the size of a holding beyond the tier it reaches. Perks are access and priority, never money: no fee discount
# (Trellis charges zero markup), no free credits, no cashback, no rebates. Per tier:
#   name, min (whole tokens)       the membership level and its threshold
#   rpm_multiplier, tpm_multiplier the key's per-minute request / token limits, multiplied (tpm defaults to rpm)
#   max_agent_keys                 active Agent Session keys per account (raises AGENT_KEYS_MAX_ACTIVE)
#   max_saved_routes               saved routes and presets per account (raises the built-in 100)
#   max_batch_rows                 lines in one batch (raises BATCH_MAX_LINES)
#   sealed_priority                place in the SEALED-lane queue when a host is full, and in Bushel purchase ordering
#   early_access_hours             how long before a newly listed model opens to everyone this tier may use it
#   vote_weight                    fixed weight in advisory holder polls (never by balance)
#   credits_never_expire           the router sends no expiry notice or sweep for this tier's keys
#   badge                          an opted-in public agent profile may show the tier name
# A tier never lowers a limit. The on-chain credits cap and tab cap (CREDITS_CAP_USDC, TAB_CAP_USDC) are safety caps
# while the programs are unaudited: no tier raises them. Off unless TRLS_TOKEN_ADDRESS is also set. Empty = perks off.
# Example (thresholds are illustrative):
# Example thresholds assume a 1,000,000,000 supply: 0.05% / 0.2% / 0.5%. The top tier stays at 0.5% on purpose;
# rescale if the supply differs, and lower them as the price rises (tiers can change).
# HOLDER_TIERS=[{"name":"Seed","min":"500000","rpm_multiplier":2,"tpm_multiplier":2,"max_agent_keys":25,"max_saved_routes":200,"max_batch_rows":2000,"sealed_priority":1,"early_access_hours":12,"vote_weight":1,"credits_never_expire":false,"badge":true},{"name":"Vine","min":"2000000","rpm_multiplier":4,"tpm_multiplier":4,"max_agent_keys":100,"max_saved_routes":500,"max_batch_rows":5000,"sealed_priority":2,"early_access_hours":24,"vote_weight":2,"credits_never_expire":true,"badge":true},{"name":"Treetop","min":"5000000","rpm_multiplier":8,"tpm_multiplier":8,"max_agent_keys":500,"max_saved_routes":1000,"max_batch_rows":10000,"sealed_priority":3,"early_access_hours":48,"vote_weight":3,"credits_never_expire":true,"badge":true}]
HOLDER_TIERS=
# SEALED (attested) lane admission. With a limit, a host serves at most that many sealed-lane calls at once (per
# router process); a call that finds its host full waits by tier sealed_priority (higher first, first come first
# served within a priority) for at most SEALED_QUEUE_MAX_WAIT_MS, then routing goes on to the next attested host.
# While both wait, SEALED_NONHOLDER_MIN_SHARE of admissions go to callers with no tier, so they are never starved.
SEALED_MAX_CONCURRENCY_PER_HOST=0    # 0 = no limit and no queue
SEALED_QUEUE_MAX_WAIT_MS=5000
SEALED_NONHOLDER_MIN_SHARE=0.2
# A model listed for the first time stays holders-first for the longest early_access_hours of any tier, at most this
# many hours. Operators set or clear one model's window: PUT / DELETE /api/v1/admin/models/:author/:slug/early-access.
EARLY_ACCESS_WINDOW_HOURS=48
AGENT_KEYS_MAX_ACTIVE=0              # active Agent Session keys per account; 0 = no cap (then no tier changes it)
# Whether settlement sends trellis_credits notice_expiry / sweep_expired for expired balances. Off: the router never
# notices or sweeps any balance. On: keys whose wallet holds a tier with credits_never_expire are skipped.
CREDITS_EXPIRY_ENABLED=false

# ---- IPX: inference price index (off unless IPX_ENABLED) ---------------------------------------
# GET /api/v1/ipx/:class serves the volume-weighted USDC price per 1,000,000 tokens for a model class,
# one value per whole hour, computed from real generations (completed, paid, not BYOK, not cached, with
# a signed receipt), plus the trailing-24h volume, a THIN flag and a merkle root over the hour's receipt
# leaves. Posting them to the IPX feed program needs IPX_KEEPER_PRIVATE_KEY on the oracle worker, which does not
# belong in the router's environment (TODO(solana): feed program client).
IPX_ENABLED=false
# Class id -> model ids (a model belongs to at most one class). Default: IPX-OPEN-70B = meta-llama/llama-3.3-70b-instruct.
# IPX_CLASSES={"IPX-OPEN-70B":["meta-llama/llama-3.3-70b-instruct"]}
IPX_CLASSES=
IPX_THIN_USDC=50000                  # trailing-24h volume (USDC) below which a class is THIN
IPX_MAX_ACCOUNT_SHARE_BPS=10000      # cap one account's share of a window's volume; 10000 = no cap
IPX_ATTESTED_ONLY=true               # count only fills whose receipt carries an attestation hash

# ---- IPX oracle publisher: signed index price updates (off unless IPX_ENABLED and IPX_ORACLE_ENABLED) ------
# The worker job `ipx-oracle` signs an update per class every IPX_ORACLE_INTERVAL_S from the latest IPX sample and
# stores it; GET /api/v1/ipx/:class/oracle serves it with the public key and how to verify it, and
# `bun scripts/ipx-oracle-verify.ts` checks one. Rules: a THIN class is marked thin with reduce_only; an update is
# valid for IPX_ORACLE_STALE_AFTER_S and a consumer must halt after that; the price moves at most
# IPX_ORACLE_MAX_MOVE_BPS per update (with an alert); IPX_ORACLE_HALTED (or PUT /api/v1/ipx/oracle/halt with the
# operator token) freezes publishing. Sinks are off unless listed. See deploy/ipx-perp/README.md.
IPX_ORACLE_ENABLED=false
IPX_ORACLE_PRIVATE_KEY=              # dedicated oracle key (0x + 32 bytes), worker only; signs messages, holds no funds
IPX_ORACLE_PUBLIC_KEY=               # the public half, for API replicas that do not hold the private key
IPX_ORACLE_ALGORITHM=ed25519         # or secp256k1-eip191
IPX_ORACLE_CLASSES=                  # comma list of IPX class ids; default: all
IPX_ORACLE_INTERVAL_S=300
IPX_ORACLE_STALE_AFTER_S=1800        # at least twice the interval
IPX_ORACLE_MAX_MOVE_BPS=1000
IPX_ORACLE_HALTED=false
IPX_ORACLE_PUBLISHERS=               # comma list: onchain, https
IPX_ORACLE_FEEDS=                    # {"IPX-OPEN-70B":"0x<IPXFeed address>"}
IPX_ORACLE_ONCHAIN_SUBMIT=false      # true: post to IPXFeed with IPX_KEEPER_PRIVATE_KEY; false: calldata only
IPX_ORACLE_PUSH_CONFIG=              # path to a JSON file describing the HTTPS push (see deploy/ipx-perp/push-config.example.json)
IPX_KEEPER_PRIVATE_KEY=              # IPXFeed keeper; only with IPX_ORACLE_ONCHAIN_SUBMIT, on a worker with no other signing key

# ---- Blind tokens: unlinkable paid access (Privacy Pass, RFC 9578 type 0x0002) --------------------
# Off unless TRELLIS_FEATURE_BLIND=true. Buyers turn credits into tokens worth 1000, 10000 or 100000
# token-units (POST /api/v1/blind/purchase; keys at GET /api/v1/blind/keys) and spend them with
# `Authorization: PrivateToken token=<base64url>` on chat and embeddings. A token pays for one request whose
# worst-case cost is at most its value; the unspent part is not refunded. Issuer keys are 2048-bit RSA, one per
# denomination per epoch, encrypted at rest with APP_SECRET and rotated every BLIND_EPOCH_SECONDS by the
# `blind-key-rotation` job (add it to WORKER_JOBS on the worker role). What is unlinkable is what the router stores: a
# token cannot be tied to the purchase that made it. Network addresses and timing are not hidden by this feature;
# hiding them needs an anonymizing network path, which this feature does not provide.
TRELLIS_FEATURE_BLIND=false
BLIND_UNIT_PRICE_USD=0.000002        # value of one token-unit: 1000 units = $0.002, 100000 units = $0.20. A key keeps the price it was created with; keys are made an epoch ahead, so a change reaches tokens from the epoch after next
BLIND_EPOCH_SECONDS=604800           # issuer key lifetime (one week)
BLIND_REDEEM_GRACE_SECONDS=604800    # tokens stay redeemable this long after their epoch stops issuing
BLIND_MAX_BATCH=32                   # most tokens per purchase request
BLIND_PURCHASE_RPM=10                # purchase requests per key per minute
BLIND_REDEEM_RPM=600                 # calls per minute per client address that present a token (a token carries its own quota)
BLIND_MAX_USD_PER_DAY=100            # most one account may convert into tokens per rolling day

# ---- Oblivious HTTP gateway and the unlinkable lane (RFC 9458) ---------------------------------------
# Off unless OHTTP_ENABLED=true, which also needs TRELLIS_FEATURE_BLIND=true (the lane is paid with blind tokens).
# The router then unwraps message/ohttp-req sent by a relay (POST /api/v1/ohttp/gateway), serves it on its own chat,
# embeddings and blind-purchase routes, and wraps the response; GET /api/v1/ohttp/keys is the key configuration and
# GET /api/v1/ohttp/key-list the signed, hash-chained key history. Lane "unlinkable" is served only for a request that
# came through a relay from an operator other than OHTTP_GATEWAY_OPERATOR, is paid with a blind token, and is routed
# only to attested providers. A relay hides your address from the router only if its operator is not the router's own
# and does not cooperate with it; the standalone relay in relay/ is meant to be run by someone else.
# Gateway keys are X25519, one per epoch, encrypted at rest with APP_SECRET, created an epoch ahead and destroyed when
# their window ends by the `ohttp-key-rotation` job (add it to WORKER_JOBS on the worker role).
OHTTP_ENABLED=false
OHTTP_KEY_EPOCH_SECONDS=86400        # gateway key lifetime (one day)
OHTTP_KEY_GRACE_SECONDS=86400        # a key keeps opening requests this long after its epoch ends (at most 100 epochs)
OHTTP_MAX_REQUEST_BYTES=8388608      # largest encapsulated request
OHTTP_MAX_RESPONSE_BYTES=8388608     # largest response the gateway will wrap
OHTTP_RELAY_RPM=6000                 # gateway requests per minute per authenticated relay
OHTTP_DIRECT_RPM=60                  # gateway requests per minute per client address that did not come through a relay
OHTTP_PAD_BYTES=256                  # responses are zero-padded to a multiple of this (0 = none)
OHTTP_GATEWAY_OPERATOR=Trellis      # how this router's own operator appears in RELAY_OPERATORS; its relays do not count as independent
OHTTP_MIN_RELAY_OPERATORS=2          # production needs relays from at least this many other operators
OHTTP_CHUNKED_ENABLED=false          # also accept chunked OHTTP (message/ohttp-chunked-req), so "stream": true works through the gateway
# The relays clients may use, published at GET /api/v1/relays. key_id names the credential the relay presents to the
# gateway (Authorization: Bearer <key_id>:<secret>); secret_sha256 is the hex SHA-256 of that secret, which the relay
# operator generates and keeps. Example (one line):
# RELAY_OPERATORS=[{"operator":"Example Relay Co","url":"https://relay.example.org/relay","key_id":"example-1","secret_sha256":"<64 hex>"}]
RELAY_OPERATORS=

# ---- Tor (optional) --------------------------------------------------------------------------------
# deploy/onion runs a v3 onion service that forwards to this router over a private network. Clients that use it hide
# their network address from the router. ONION_ADDRESS is that service's hostname, published at GET /api/v1/status and
# offered to Tor Browser in an Onion-Location header on the site's pages. ONION_PROXY_SECRET is the secret the onion
# proxy sends in X-Trellis-Onion (use the same value there): a request that carries it is an onion request, and only then.
# Onion requests have no client address, so calls without an API key (unkeyed chat and embeddings, new keys, wallet
# sign-in challenges, the paymaster, the gateway's direct limit) share one bucket per limit, ONION_POOL_MULTIPLIER times
# the limit of one address and apart from every real address. Calls with an API key are limited per key as usual.
# A comma list of up to three secrets lets you rotate: add the new one here, switch the proxy, then drop the old one.
ONION_ADDRESS=
ONION_PROXY_SECRET=
ONION_POOL_MULTIPLIER=10
# Also serve lane "unlinkable" over Tor: to requests that carry ONION_PROXY_SECRET (so only the onion proxy's) and are
# paid with a blind token, from attested providers only. Tor hides the client's address instead of an independent
# Oblivious HTTP relay; the router still sees the request itself, as on the relay path. Needs ONION_ADDRESS,
# ONION_PROXY_SECRET and TRELLIS_FEATURE_BLIND=true, and does not need or change OHTTP_ENABLED.
UNLINKABLE_VIA_ONION=false

# ---- Routing / health / canaries / attestation ----------------------------------------------
OUTAGE_WINDOW_MS=30000
HEALTH_PROBE_INTERVAL_MS=15000
PROVIDER_TIMEOUT_MS=120000
FIRST_TOKEN_TIMEOUT_MS=45000
MAX_PROVIDER_ATTEMPTS=4
# Selection weight = uptime x quality x attested_bonus / price^2, per lane. The bonus applies to endpoints served
# under the attested class (attested retention and a fresh, verified attestation). At least 1.
ATTESTED_BONUS_PUBLIC=1.25
ATTESTED_BONUS_ATTESTED=1
ATTESTED_BONUS_UNLINKABLE=1
CANARIES=true
CANARY_INTERVAL_MS=3600000
SHADOW_DAYS=7
ATTESTATION_INTERVAL_MS=600000
ATTESTATION_HISTORY_DAYS=30          # days of attestor, canary and probe events kept for GET /api/v1/attestation/summary; 0 records nothing and turns the two history endpoints off
ALLOW_DEV_ATTESTATION=false          # never true in production
TDX_VERIFIER_URL=                    # DCAP quote verification service (required for TDX providers)
TDX_VERIFIER_KEY=
NVIDIA_NRAS_URL=https://nras.attestation.nvidia.com/v3/attest/gpu
NRAS_ISSUER=https://nras.attestation.nvidia.com   # whose signed GPU tokens the attestor accepts (never taken from a provider's document)
NRAS_JWKS_URL=                       # its signing keys; default <NRAS_ISSUER>/.well-known/jwks.json
ATTESTATION_VERIFIERS=dcap           # comma list of dcap, intel-ta, dstack, tee-cloud; every listed verifier must accept a quote
INTEL_TA_URL=https://api.trustauthority.intel.com/appraisal/v2/attest
INTEL_TA_JWKS_URL=https://portal.trustauthority.intel.com/certs
INTEL_TA_API_KEY=                    # required when intel-ta is listed
DSTACK_VERIFIER_URL=                 # a dstack verifier's verify endpoint; required when dstack is listed
DSTACK_VERIFIER_KEY=
TEE_CLOUD_VERIFIER_URL=  # the TEE cloud's public quote verifier, used when tee-cloud is listed (no TCB status: pair it with dcap or intel-ta to enforce one)
# Measurements (off by default): record the image/compose/model digests bound into verified quotes, look them up in
# Rekor and prepare MeasurementRegistry.register() calldata. Nothing is submitted on chain.
MEASUREMENTS_ENABLED=false
MEASUREMENTS_INTERVAL_MS=300000
REKOR_URL=https://rekor.sigstore.dev
REKOR_PUBLIC_KEY=                    # PEM of the log's checkpoint key; without it checkpoints are not verified
MEASUREMENT_PUBLIC_KEY=              # PEM (ECDSA P-256) of the key that signs measurement bundles; setting it turns on bundle checking (public key only)
MEASUREMENT_REGISTRY_ADDRESS=        # only used as the target of the prepared calldata and for read-back
# Per-host anchoring of enclave receipts (off by default: no job, no route). The `host-anchor` job (add it to WORKER_JOBS
# on the worker that holds ANCHORER_PRIVATE_KEY, next to receipts-anchor) collects each attested sidecar's receipt leaves,
# keeps those signed by the receipt key its verified attestation binds, and roots them per host and interval. With a
# ReceiptAnchor address and the anchorer key it posts each root with anchorAttested; otherwise roots stay off chain.
# Set HOST_ANCHOR_ENABLED on the api role as well, to serve /api/v1/host-anchors/proof.
HOST_ANCHOR_ENABLED=false
HOST_ANCHOR_INTERVAL_MS=3600000
HOST_ANCHOR_TOKENS=                  # JSON {"<provider id>": "<that sidecar's SIDECAR_ANCHOR_TOKEN>"}; worker role only

# ---- The Lane: open-weights variants, day-zero pipeline, creator claims -----------------------------------
# A model that is abliterated or native_low_refusal (declared with PUT /api/v1/models/{author}/{slug}/lane) is served only
# by providers under attested retention whose verified attestation reports the in-enclave classifier as enabled.
# Day-zero pipeline (off by default): watch Hugging Face for new fine-tunes of the listed base models, check their
# license, and create candidates. A candidate is served only after an operator approves it and an attested provider
# that reports the classifier serves it. Add `dayzero` to WORKER_JOBS on the worker role.
DAYZERO_ENABLED=false
DAYZERO_INTERVAL_MS=900000
DAYZERO_BASE_MODELS=                 # comma list of Hugging Face repositories (owner/name); required when enabled
DAYZERO_LICENSES=mit,apache-2.0      # license ids (model card metadata) a base model and a derivative may carry
DAYZERO_KEYWORDS=abliterated,uncensored,decensored,unfiltered
DAYZERO_MAX_PER_RUN=25
DAYZERO_MAX_REFUSAL_RATE=0.25        # largest share of the benign probe set a candidate may refuse
DAYZERO_MIN_CAPABILITY=0.8           # smallest share of the exact-check set a candidate must answer correctly
DAYZERO_MIN_CANARY=0.75
# Creator royalty claims (POST /api/v1/creators/claims): the rate is DEFAULT_ROYALTY_BPS (500 = 5%, at most 2000).
LANE_CLAIM_TTL_S=86400
LANE_CLAIM_FILE=trellis-claim.txt

# ---- Gateway features -----------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=         # e.g. http://otel-collector:4318
OTEL_SERVICE_NAME=trellis
CACHE_TTL_S=3600
SEMANTIC_CACHE_THRESHOLD=0.97
# Council mode (model "trellis/council": member models plus a judge) and dual verification (verify: "dual"). Off by default.
TRELLIS_FEATURE_COUNCIL=false
TRELLIS_COUNCIL_MODELS=             # comma list of 2-5 model ids used when a request sends no council.models
TRELLIS_COUNCIL_JUDGE=              # judge model id used when a request sends no council.judge
TRELLIS_COUNCIL_MODE=judge          # judge | fuse
# Private RAG (POST /api/v1/rag): the most one request may carry. Document text is never stored.
RAG_MAX_DOCUMENTS=200
RAG_MAX_BYTES=2097152                # total UTF-8 bytes of document text
RAG_MAX_CHUNKS=2000
RAG_MAX_EMBEDDING_CALLS=64           # embeddings calls one request may make
# Batch API (POST /api/v1/batches): lines run on the worker at a discount; requests and answers are kept sealed
# in Redis (or memory), never in Postgres, until BATCH_RESULTS_TTL seconds after the batch finishes.
BATCH_DISCOUNT_BPS=0                 # 0 by default: a discount is paid by the operator. A non-zero value needs PROVIDER_FEE_BPS at least as large.
BATCH_MAX_LINES=1000
BATCH_MAX_BYTES=8388608
BATCH_MAX_ACTIVE=2                   # unfinished batches per key
BATCH_RESULTS_TTL=86400              # seconds
BATCH_INTERVAL_MS=2000
BATCH_LINES_PER_TICK=20
BATCH_CONCURRENCY=4
BATCH_LINE_MAX_ATTEMPTS=3
# Secured Skills Hub (/api/v1/skills): agent skills imported from a repository or an archive, hashed and scanned.
SKILLS_MAX_BYTES=5242880             # unpacked bytes of one skill
SKILLS_MAX_FILES=500
SKILLS_ALLOWED_HOSTS=                # extra hosts for the scanner's network allowlist, comma-separated
SKILLS_DOWNLOAD_LEVELS=trusted,caution
SKILLS_FEE_BPS=0                    # zero markup: the author gets the whole install price
SKILLS_SOURCES=                      # mirror job: [{"kind":"git","url":"https://...","ref":"main"},{"kind":"index","url":"https://..."}]
DEFAULT_RPM=600
DEFAULT_TPM=0
UNAUTH_RPM=60
NEW_KEYS_PER_HOUR=10
TELEGRAM_BOT_TOKEN=                  # optional: BotFather token; runs the Telegram bot (long polling; users can /private on to chat on the attested lane only). Empty = bot off

# ---- Anthropic Messages endpoint (POST /v1/messages) ------------------------------------------------------
# Optional. Any catalog model id works as sent. To let a client that sends an Anthropic model name use a catalog model,
# map the name (an exact name, a prefix ending in *, or a lone * for any other name):
#   ANTHROPIC_MODEL_MAP={"claude-sonnet-4-5":"meta-llama/llama-3.3-70b-instruct","claude-haiku-*":"qwen/qwen3-32b"}
ANTHROPIC_MODEL_MAP=

# ---- Receipt-backed identity and reputation (v6 I; both off by default; both need AGENT_PROFILES_ENABLED) ----------
# ERC-8004 identities for opted-in agent profiles, daily signed liveness probes (job agent-liveness) and track records.
AGENT_IDENTITY_ENABLED=false
# Feedback only from the payer on a receipt that paid or served the agent; weighted by amount, halving every N days.
PAID_FEEDBACK_ENABLED=false
PAID_FEEDBACK_HALF_LIFE_DAYS=90
# owner: the router returns register() calldata for the owner's wallet. registrar: an isolated worker with
# WORKER_JOBS=agent-identity and AGENT_IDENTITY_REGISTRAR_KEY (a funded key, no other signing role) sends it.
AGENT_IDENTITY_MODE=owner
AGENT_IDENTITY_REGISTRAR_KEY=
# Agent identity registries. TODO(solana): ERC-8004 is an EVM standard; no registry is configured by default on Solana.
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=
ERC8004_VALIDATION_REGISTRY=
ERC8004_VALIDATOR_ADDRESS=           # who answers validation requests; default the registrar's address
AGENT_LIVENESS_INTERVAL_MS=86400000
AGENT_LIVENESS_TIMEOUT_MS=10000

# Planned network host payouts; not switched on yet. NETWORK_FEE_BPS defaults to 0 (zero markup).
NETWORK_PAYOUTS_ENABLED=false

# ---- Pay another agent (off by default; needs AGENT_GUARD_ENABLED) ------------------------------------------------
# Agent Guard decides pay.agent with the payer's rulebook; the payer's own wallet sends USDC on Solana straight
# to the recipient; the router verifies the transfer (ESCROW_FINALITY, ESCROW_REORG_HORIZON_BLOCKS) and signs a receipt.
# Trellis never holds the money. Job agent-pay-verify settles seen payments and re-checks final ones.
AGENT_PAY_ENABLED=false
# SITE_URL=https://trellis.example     # B116: address shown in links people open; defaults to PUBLIC_BASE_URL; receipts' signed issuer is unchanged.

# ---- Solana payment paths (docs/Trellis_Backend.md §5.2, §6; dev faucet) -------------------------------------------
# Tab billing on the chat routes: X-Trellis-Tab + X-Trellis-Tab-Voucher (src/solana/tab-billing.ts). The payee a tab must
# name; defaults to X402_PAY_TO, then the router signing key. Job tab-close posts the highest voucher when a tab nears its
# cap or expiry; it needs ROUTER_PRIVATE_KEY to be that payee.
TAB_PAYEE=
# Pay with a tokenized stock (X-Pay-With, src/solana/paywith.ts): Jupiter swap API base URL (quote + swap, ExactOut) and
# Pyth Hermes for the price sanity check (PAYWITH_TOKENS entries carry the Pyth feed id as `feed`).
JUPITER_API_URL=https://lite-api.jup.ag
PYTH_HERMES_URL=https://hermes.pyth.network
# Test USDC faucet for localnet and devnet only (refused in production and on mainnet-beta): POST /api/v1/dev/faucet mints
# test USDC to the faucet wallet and deposits it through trellis_credits. DEV_FAUCET_PRIVATE_KEY must be the mint authority.
FAUCET_ENABLED=false

# ---- Devnet (scripts/devnet, deployments/devnet.json) -----------------------------------------------------------------
# A router against the devnet deployment takes config/devnet.env.example on top of this file: devnet RPC, CAIP-2 network
# solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1, CHAIN_ID=103, Circle's devnet USDC mint, the TRELLIS_*_PROGRAM_ID values and the
# test $TRLS mint. Program ids, config PDAs, mints and the authority public keys are recorded in deployments/devnet.json;
# the receipt signing key's secret lives only in the gitignored deployments/devnet.secrets.json.

# ---- Supply: warm pool on rented GPU networks (docs/Trellis_Backend.md §2; all off by default) ----------------------
# Pinned open-weight models as vLLM deployments on the Nosana GPU market and on io.net clusters, sized from the last
# hour's demand under SUPPLY_HOURLY_BUDGET_USD and registered as providers (OPEN lane; shadow first unless
# SUPPLY_PROVIDER_STATUS=live). Credentials are read from the environment only and are never logged or stored.
SUPPLY_NOSANA_ENABLED=false
SUPPLY_IONET_ENABLED=false
SUPPLY_HOURLY_BUDGET_USD=0                # most the pool may cost per hour across both networks; 0 keeps it at zero replicas
# SUPPLY_MODELS=[{"model":"author/slug","hf_repo":"Owner/Repo","revision":"<40-hex commit>","weights_sha256":"<64 hex>","image":"docker.io/vllm/vllm-openai@sha256:<64 hex>","context_length":32768,"price_prompt_usd_per_mtok":0.1,"price_completion_usd_per_mtok":0.3,"tokens_per_replica_hour":3000000,"max_replicas":2,"adapters":["nosana","ionet"]}]
SUPPLY_INTERVAL_MS=300000
SUPPLY_HEADROOM=1.2                       # replicas are sized for demand times this
SUPPLY_SCALE_DOWN_AFTER_MIN=30            # a deployment younger than this is never torn down
SUPPLY_PROVIDER_STATUS=shadow             # shadow (canaries first) | live
NOSANA_API_URL=https://dashboard.k8s.prd.nos.ci/api
NOSANA_API_KEY=                           # dashboard API key; secret
NOSANA_MARKET=                            # address of the GPU market the jobs are posted to
NOSANA_TIMEOUT_MIN=120
NOSANA_STRATEGY=SIMPLE
IONET_API_URL=https://api.io.solutions/enterprise/v1/io-cloud/caas
IONET_API_KEY=                            # IO Cloud API key; secret
IONET_HARDWARE_ID=
IONET_LOCATION_IDS=                       # comma list of io.net location ids
IONET_GPUS_PER_CONTAINER=1
IONET_DURATION_HOURS=1
IONET_MIN_TOKENS_PER_HOUR=5000000         # io.net is used only for a model whose last-hour demand reached this

# ---- Bushels: prepaid capacity (docs/Trellis_Backend.md §5.6; off by default) -----------------------------------------
# Needs TRELLIS_CAPACITY_PROGRAM_ID and SETTLEMENT_PRIVATE_KEY as the program's sale authority. Lots are bound to the
# buying key, cannot be transferred and are redeemable only for inference on the committed grade.
BUSHELS_ENABLED=false
BUSHEL_ISSUANCE_CAP_USD=250000            # cap on prepaid capacity outstanding while the programs are unaudited; lower is allowed, higher is refused
BUSHEL_COMMITMENTS=                       # comma list of commitment accounts on offer; empty = every open commitment the RPC lists
BUSHEL_SALE_WINDOW_MS=250                 # requests for one commitment inside this window are served in holder-priority order
BUSHEL_MIN_TOKENS=100000
BUSHEL_AUTHORITY_ROLE=settlement          # which role key signs report_shortfall / rehome_lot / claim_lot_shortfall
BUSHEL_MIN_UPTIME=0.95                    # a host below this share of successful health samples in its window under-delivered
BUSHEL_SHORTFALL_INTERVAL_MS=3600000

# ---- Catalogue auto-listing (docs/Trellis_Backend.md §2; job off by default) -------------------------------------------
# Candidates are submitted and approved through /api/v1/admin/catalog/candidates. MIT and Apache-2.0 list without review;
# Gemma and Llama licences (and their derivatives) need an operator's licence check; unknown licences are blocked.
AUTOLIST_ENABLED=false
AUTOLIST_INTERVAL_MS=900000
AUTOLIST_TARGET_HOURS=24
AUTOLIST_MIN_EVAL_SCORE=0.8
AUTOLIST_MIN_CANARY_ACCURACY=0.6

# ---- Honest Ledger (docs/Trellis_Backend.md §9; job off by default) ---------------------------------------------------
# Daily x402 volume through Trellis after the wash filter, at GET /api/v1/ledger/honest with the filter published.
HONEST_LEDGER_ENABLED=false
HONEST_LEDGER_MIN_PAYMENT_USD=0.001
HONEST_LEDGER_LOOKBACK_DAYS=2
HONEST_LEDGER_INTERVAL_MS=86400000

# ---- Measurement registry (docs/Trellis_Backend.md §3): approved model digests and compose hashes on chain ----
TRELLIS_MEASUREMENTS_PROGRAM_ID=      # trellis_measurements program id (see deployments/<cluster>.json)
MEASUREMENT_AUTHORITY_ROLE=           # which signing role may submit register instructions (e.g. anchorer); empty = prepare only
MEASUREMENTS_ONCHAIN_SUBMIT=false     # true sends the keeper's prepared register instructions; with a multisig authority leave false
HVX_PUBLISH_ONCHAIN=false             # true publishes the hourly index through trellis_capacity::publish_hvx
HVX_AUTHORITY_ROLE=                   # signing role for that publish
