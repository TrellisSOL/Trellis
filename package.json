{
  "name": "trellis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One API for every open model, paid in USDC on Solana, with proof of where it ran.",
  "scripts": {
    "launch": "bun scripts/launch.ts",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test --timeout 20000",
    "test:chain": "scripts/test-chain.sh",
    "test:pg": "TEST_PG_URL=${TEST_PG_URL:-postgres://postgres@127.0.0.1:55432/postgres} TEST_REDIS_URL=${TEST_REDIS_URL:-redis://127.0.0.1:56379} bun test --timeout 20000",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "providers:mock": "bun scripts/mock-providers.ts",
    "seed": "bun scripts/seed.ts",
    "key": "bun scripts/key.ts",
    "services:up": "scripts/services.sh up",
    "services:down": "scripts/services.sh down",
    "monitor": "bun scripts/monitor.ts",
    "alert:drill": "bun scripts/alert-drill.ts",
    "backup:offsite": "bun scripts/backup-offsite.ts",
    "compose:check": "bun scripts/compose-graph-check.ts",
    "docs:claims": "bun scripts/docs-claims-check.ts",
    "docs:claims:live": "bun scripts/docs-claims-check.ts --live https://trellis.example"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@cloudflare/blindrsa-ts": "0.4.6",
    "@electric-sql/pglite": "0.5.8",
    "@hono/trpc-server": "0.4.2",
    "@noble/hashes": "2.4.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0",
    "@swig-wallet/classic": "2.1.0",
    "@trpc/server": "11.19.0",
    "bs58": "6.0.0",
    "bullmq": "6.3.9",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "hpke": "1.1.7",
    "ioredis": "6.0.0",
    "ohttp-ts": "0.6.0",
    "postgres": "3.4.9",
    "viem": "2.56.9",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^26",
    "@wallet-standard/app": "1.1.1",
    "chai": "^4",
    "drizzle-kit": "0.31.11",
    "litesvm": "1.6.0",
    "mocha": "^10",
    "openai": "7.23.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
