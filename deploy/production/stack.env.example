# Compose variables for deploy/production/docker-compose.yml. Copy to stack.env (gitignored, mode 0600) and fill in.
#   docker compose --env-file stack.env config -q
# bootstrap.sh --generate-secrets fills the three passwords below when they are empty. They must be URL-safe
# (letters and digits): the compose file puts them into the database and Redis URLs.

# ---- Public host name -----------------------------------------------------------------------------------------------
# The DNS name of this host. Caddy obtains a certificate for it. Must match PUBLIC_BASE_URL in .env.production.
# "localhost" starts the stack on a workstation with a locally issued certificate.
TRELLIS_DOMAIN=trellis.example
HTTP_PORT=80
HTTPS_PORT=443

# ---- Images, pinned by digest ---------------------------------------------------------------------------------------
# The application image is built from the repository root (README.md, "Build the image") and referenced by the digest
# the registry or `docker image inspect` reports. The others are the upstream images at the digests checked on
# 2026-10-12; refresh one with: docker buildx imagetools inspect <name:tag> --format '{{.Manifest.Digest}}'
TRELLIS_IMAGE=
POSTGRES_IMAGE=postgres:16.6@sha256:557fea37a744d5f4c8faab304b0a90858b53ab119735a88c131fd19dab802f36
# Timescale is optional: the migrations turn the two time-series tables into hypertables when the extension is present
# and work without it. The encrypted backup and restore drill of this folder passes on the PostgreSQL image above; on a
# Timescale image it does NOT (a new database there is not empty, which scripts/restore-db.sh refuses, and hypertables
# need Timescale's own restore steps). Switch only after a restore has been drilled on that image:
# POSTGRES_IMAGE=timescale/timescaledb:2.17.2-pg16@sha256:4e459e217f00cbb09920c34d245501e63427e6767a495de57ce76823ff280f12
REDIS_IMAGE=redis:8.0.4@sha256:a377481f6820efffb07a879de1703a0f6086e188b9aa89f5801563631166090b
CADDY_IMAGE=caddy:2.10.2@sha256:c3d7ee5d2b11f9dc54f947f68a734c84e9c9666c92c88a7f30b9cba5da182adb
# Profile "monitoring" only:
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1@sha256:27c475db5fb156cab31d5c18a4251ac7ed567746a2483ff264516437a39b15ba
# Profile "backup" only. Empty: compose builds deploy/production/backup.Dockerfile as trellis-backup:local.
BACKUP_IMAGE=

# ---- Database and Redis -----------------------------------------------------------------------------------------------
POSTGRES_USER=trellis_owner
POSTGRES_DB=trellis
# The schema owner: used by the migration job and the role-grant job only. Never given to the API or a worker.
POSTGRES_PASSWORD=
# The password of trellis_runtime, the role the API and the workers connect as (data changes only).
RUNTIME_DB_PASSWORD=
REDIS_PASSWORD=
# Sizing (README.md, "Sizing"): the defaults fit an 8 GB host.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MEM_LIMIT=2g
API_MEM_LIMIT=2g

# ---- Off-host backup (profile "backup") ---------------------------------------------------------------------------------
# Public age recipients only (age1...). The private identity never comes to this host: keep it offline.
BACKUP_AGE_RECIPIENTS=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=trellis/
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ---- Alert delivery (profile "monitoring") -------------------------------------------------------------------------------
# A file that contains only the on-call webhook URL (readable by uid 65534). The URL is a secret; it is never an env var.
ALERT_WEBHOOK_URL_FILE=./secrets/alert-webhook-url

# ---- Launch surface -----------------------------------------------------------------------------------------------------
# core (the default): only the allow-listed routes and jobs exist on the API and the workers (src/surface/core-allowlist.ts).
# all registers every feature and needs the acknowledgement; read security/DEFERRED.md before setting it. worker-tabs
# (the tab-close job) is part of the launch and starts with the stack; the profiles "slasher" and "makegood" belong to
# `all` only.
LAUNCH_SURFACE=core
LAUNCH_SURFACE_ACK=
