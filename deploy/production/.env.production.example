# Router settings for production, shared by the API and every worker (deploy/production/docker-compose.yml).
# Copy to .env.production (gitignored, mode 0600). Names and rules are those of src/config.ts; this file lists every
# setting production requires, with the value mainnet uses or an empty value where only you can fill it in.
#
# NOT in this file, on purpose:
#   signing keys                 one file per service under secrets/ (secrets.example/ has the templates)
#   DATABASE_URL, REDIS_URL      assembled by the compose file from stack.env
#   RUNTIME_ROLE, WORKER_JOBS, HOST, PORT, AUTO_MIGRATE, TRUST_PROXY, TRELLIS_ENV   set per service by the compose file
#
# Check it before starting anything:  ./bootstrap.sh --check   (loads each service's settings through the router's validator)

# ---- Identity of this deployment --------------------------------------------------------------------------------------
# The public https origin. On a reserved top-level domain (.example, .test, .invalid, .localhost) the router treats the
# deployment as a fixture and starts without a deployment manifest; on a real domain it requires the three settings at
# the end of this file. Replace the placeholder with: bun scripts/rename-placeholders.ts --domain <your domain> ...
PUBLIC_BASE_URL=https://trellis.example
LOG_LEVEL=info

# ---- Secrets every router process shares (bootstrap.sh --generate-secrets fills the two that are empty) ----------------
# APP_SECRET encrypts provider credentials and receipt keys at rest: at least 32 characters. Losing it makes the stored
# keys unreadable; changing it has the same effect. Keep an offline copy with the backup identity.
APP_SECRET=
# The operator token for the admin interface: at least 24 characters.
ADMIN_TOKEN=

# ---- Solana ---------------------------------------------------------------------------------------------------------------
CHAIN_ID=101
SOLANA_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
X402_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
SOLANA_COMMITMENT=confirmed
# The private RPC URL from your RPC provider (a secret when it carries a key; the router redacts it from logs and errors).
SOL_RPC_URL=
# Comma-separated fallbacks; empty disables them.
SOL_RPC_FALLBACK_URLS=
# The endpoint shown to wallets. Never the private URL: the router refuses a PUBLIC_RPC_URL that equals a private one.
PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
EXPLORER_URL=https://explorer.solana.com
USDC_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ---- Launch tier and Trellis programs: paste the block printed by `bun scripts/mainnet/verify.ts --i-understand-this-is-mainnet --env` ----
# Which programs this deployment has (MAINNET.md, "Launch tiers"). The router requires the tier's programs and switches
# off, and says so at /api/v1/status, every feature whose program is not deployed:
#   minimal   no program: pay-per-call x402 only (the launch)   credits   + trellis_credits (update 1)
#   payments  + trellis_tab and trellis_anchor                   full      all programs (requires the four names below)
# A tier above minimal is a setting of update 1 (UPDATES.md): a production router refuses it until that update is released.
LAUNCH_TIER=minimal
# The launch surface is set for the whole stack in stack.env (LAUNCH_SURFACE, default core): only the allow-listed
# routes and jobs exist (src/surface/core-allowlist.ts). A setting that switches on any other feature stops a core
# router from starting. BATCH_DISCOUNT_BPS must stay 0 (the default): a discount is paid by the operator.
# Where the hourly receipt roots go: `memo` (one memo transaction an hour signed by the anchorer key: no rent, no
# program) or `program` (trellis_anchor accounts). Empty: program when TRELLIS_ANCHOR_PROGRAM_ID is set, else memo.
ANCHOR_MODE=
# The anchorer's PUBLIC key (the public half of worker-anchor's ANCHORER_PRIVATE_KEY). In memo mode the API publishes
# it at /.well-known/trellis-receipt-keys.json and writes it into every proof; required there.
ANCHORER_ADDRESS=
# Only after the anchorer key was rotated (scripts/mainnet/anchorer-rotate.ts prints the line): every key in order,
# so roots signed by an earlier key stay verifiable. JSON, one line.
# ANCHORER_KEYS=[{"key":"<first>","from_hour":0},{"key":"<current>","from_hour":<unix hour>,"rotation_tx":"<signature>"}]
# Program ids. Leave empty what the tier does not deploy.
TRELLIS_CREDITS_PROGRAM_ID=
TRELLIS_TAB_PROGRAM_ID=
TRELLIS_BOND_PROGRAM_ID=
TRELLIS_ANCHOR_PROGRAM_ID=
TRELLIS_RULES_PROGRAM_ID=
TRELLIS_FEE_ROUTER_PROGRAM_ID=
TRELLIS_CAPACITY_PROGRAM_ID=
TRELLIS_MEASUREMENTS_PROGRAM_ID=
# The production guard of src/config.ts checks the deployment manifest against these four older names: set each one
# whose program the tier deploys (same value as above) and leave the others empty. They carry credits, trellis_tab
# (the per-call payment program), trellis_bond and trellis_anchor.
CREDITS_ADDRESS=
CALLPAY_ADDRESS=
PROVIDER_BOND_ADDRESS=
RECEIPT_ANCHOR_ADDRESS=
HOST_BOND_ADDRESS=
# The treasury wallet (the Squads vault; its USDC account is the treasury) and the refund pool token account.
TREASURY_ADDRESS=
REFUND_POOL_ADDRESS=

# How often the settlement job runs. Every run that changes the spend root creates one small account on chain (about
# 0.0014 SOL of rent that trellis_credits cannot return yet): once a day costs about 0.04 SOL a month, the hourly
# default about 1 SOL. With no self-run hosts to pay there is no reason for hourly.
SETTLEMENT_INTERVAL_MS=86400000

# ---- Caps while the programs are unaudited (the router refuses higher values) -----------------------------------------------
TAB_CAP_USDC=500
CREDITS_CAP_USDC=5000
CREDITS_REFUND_DELAY_H=72
# Prepaid capacity (Bushels) is off at launch; when it is switched on its cap is at most 250000.
BUSHELS_ENABLED=false
BUSHEL_ISSUANCE_CAP_USD=250000

# ---- Pricing: zero markup, every fee setting 0 ---------------------------------------------------------------------------------
PER_CALL_MARGIN_BPS=0
PROVIDER_FEE_BPS=0
BYOK_FEE_BPS=0
FACILITATOR_FEE_BPS=0
SKILLS_FEE_BPS=0
# The creator share is a pass-through to the model creator, not a Trellis fee (docs Overview §4).
# Creator claims and royalties are not on the core launch surface: no model carries a royalty there.
DEFAULT_ROYALTY_BPS=0

# ---- Payments -----------------------------------------------------------------------------------------------------------------
# The wallet x402 `exact` payments are sent to: one you control, and not a program account. Empty: x402 per call is off.
X402_PAY_TO=
# The payee tabs must name. Empty: X402_PAY_TO, else the router signing key (which is what the tab-close job signs with).
TAB_PAYEE=

# ---- Sanctions screening (required: deposits, closure refunds, payouts and facilitator listings are screened) ------------------
SANCTIONS_SCREENING_ENABLED=true
# Empty uses the official list export; production accepts only the list publisher's own hosts.
SANCTIONS_LIST_URL=
SANCTIONS_MAX_AGE_DAYS=7

# ---- Attestation ----------------------------------------------------------------------------------------------------------------
# Which services must accept a TEE quote: a comma list of dcap, intel-ta, dstack, tee-cloud. Every listed one must accept.
# `tee-cloud` (the TEE cloud's public quote verifier, no credentials) checks the quote's signature and certificate chain
# and reports no patch level, so a production router does not start on it alone: the list must include `dcap` (set
# TDX_VERIFIER_URL, https) or `intel-ta` (set INTEL_TA_API_KEY), which check the platform's TCB status. A revoked or
# out-of-date platform is then not attested. With `dcap` listed and TDX_VERIFIER_URL empty the gateway never attests.
ATTESTATION_VERIFIERS=tee-cloud,dcap
TEE_CLOUD_VERIFIER_URL=  # HTTPS quote verifier selected by the operator
TDX_VERIFIER_URL=
TDX_VERIFIER_KEY=
INTEL_TA_API_KEY=
ALLOW_DEV_ATTESTATION=false

# ---- The attested gateway (SEALED lane launch supply; seeded by bootstrap.sh with deploy/production/seed-gateway.ts) ----------
# The gateway's OpenAI-compatible base URL and its attestation URL, from the gateway provider (config/devnet.env.example
# names the one the devnet walkthrough verified). Its API key goes in secrets/providers.env.
PRIVATE_AI_BASE_URL=
PRIVATE_AI_ATTESTATION_URL=
# The gateway's measurement pin (required in production; the header of seed-gateway.ts says what it covers and what it
# does not). `seed-gateway.ts --check` prints each line below for the quote the verifiers accepted: appraise the release,
# then fill them in. The first six are always required; the last four whenever --check prints them. Any change in one
# of them at the gateway, its keyset included, takes it off the SEALED lane and raises the alert TrellisGatewayPinMismatch
# until you re-pin here and run bootstrap.sh again. Nothing is adopted automatically.
PRIVATE_AI_MRTD=
PRIVATE_AI_RTMR0=
PRIVATE_AI_RTMR1=
PRIVATE_AI_RTMR2=
PRIVATE_AI_RTMR3=
PRIVATE_AI_KEYSET_DIGEST=
PRIVATE_AI_COMPOSE_HASH=
PRIVATE_AI_OS_IMAGE_HASH=
PRIVATE_AI_APP_ID=
PRIVATE_AI_KEY_PROVIDER=

# ---- $TRLS and holder tiers (off until both are set; tiers give access and priority only, never a price change) ----------------
TRLS_TOKEN_ADDRESS=
TRLS_TOKEN_SYMBOL=TRLS
TRLS_TOKEN_DECIMALS=9
# JSON list of tiers with fixed thresholds; .env.example at the repository root has the full example. Empty: tiers are off.
HOLDER_TIERS=
# Credit expiry on chain (notice, then sweep after the grace period). Off until the notice process is in place.
CREDITS_EXPIRY_ENABLED=false

# ---- Operations -------------------------------------------------------------------------------------------------------------------
# Readiness reports backup_fresh once the scheduled off-host backup has run inside BACKUP_MAX_AGE_HOURS.
BACKUP_REQUIRED=true
BACKUP_MAX_AGE_HOURS=26
# The on-call webhook of the alert-notifier job (a secret URL: an ntfy topic, a chat webhook, or any JSON endpoint).
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=

# ---- Request bodies and limits (security review R5-05, R5-06; the values below are the defaults) -------------------------------
# The body cap of the chat routes, in bytes. The launch has no image models; a production core router refuses more than
# 4194304. Every other route takes REQUEST_MAX_BYTES. The Caddyfile's request_body max_size must not be lower than either.
INFERENCE_MAX_BYTES=2097152
REQUEST_MAX_BYTES=1048576
# The request-body bytes one API process holds at a time, all requests together (at least four times the largest cap);
# past it a request with a body is answered 503 with Retry-After. One source address holds at most a quarter of it.
# Measured: 32 MiB of worst-shape bodies in flight at once cost about 0.5 GiB of resident memory (API_MEM_LIMIT is 2g).
BODY_BUDGET_BYTES=33554432
# A request body must arrive whole within this many milliseconds (408, and the connection is closed).
BODY_READ_MS=30000
# Requests a minute from one source address that no funded key on an inference route speaks for (/ready included).
ANON_RATE_PER_MIN=120
# How long one readiness computation answers GET /ready and /ready/metrics, and one GET /api/v1/status, in milliseconds.
READY_CACHE_MS=5000
STATUS_CACHE_MS=10000
# Live sub-keys one account may have, and sub-keys one account may create in an hour.
SUB_KEYS_MAX=50
# Security review R5-04 / R5-05 (defaults shown). ACCOUNT_RPM: inference requests a minute for one account over all of
# its keys. INFLIGHT_PER_KEY / INFLIGHT_PER_SOURCE: inference calls one key (without a key: one source address) may
# have open at a time, per replica. SLOW_CALLS_PER_10MIN: calls of one key or source the router had to cut off (its
# timeout, an answer above the size it reads) in ten minutes before further ones are refused. 0 turns a limit off.
# ACCOUNT_RPM=1200
# INFLIGHT_PER_KEY=16
# INFLIGHT_PER_SOURCE=8
# SLOW_CALLS_PER_10MIN=20
SUB_KEYS_PER_HOUR=20

# ---- Measurement registry and HVX on chain (both off at launch) ---------------------------------------------------------
# trellis_measurements is the allow-list of digests a Graft host may run. After the handover its authority is the
# multisig, so the router prepares register instructions and sends nothing: keep MEASUREMENTS_ONCHAIN_SUBMIT=false.
# It can only be true while the key of MEASUREMENT_AUTHORITY_ROLE is the registry's authority.
MEASUREMENTS_ENABLED=false
MEASUREMENTS_ONCHAIN_SUBMIT=false
MEASUREMENT_AUTHORITY_ROLE=keeper
# HVX is a public statistic. Publishing it to trellis_capacity's feed needs the key of HVX_AUTHORITY_ROLE to be the
# config's hvx_authority; init.ts sets that to the multisig vault unless MAINNET_HVX_AUTHORITY names a key, so on-chain
# publishing stays off until the multisig assigns one (update_config) and a worker holds it.
HVX_ENABLED=false
HVX_PUBLISH_ONCHAIN=false
HVX_AUTHORITY_ROLE=keeper

# ---- Lanes and features that stay off at launch ------------------------------------------------------------------------------------
TRELLIS_FEATURE_BLIND=false
OHTTP_ENABLED=false
TOOLS_MARKET_ENABLED=false
MAKEGOOD_ENABLED=false
FAUCET_ENABLED=false
DEV_FAUCET=false

# ---- Release identity and the deployment guard (required on a real domain) -----------------------------------------------------------
# The full 40-character commit of the build. The image carries it when built with --build-arg RELEASE_COMMIT=<commit>;
# set it here only to override.
# RELEASE_COMMIT=
# Written by `bun scripts/mainnet/verify.ts --i-understand-this-is-mainnet --write-report`; the compose file mounts
# deployments/ read-only at this path. Write them again after the handover and after every program upgrade.
# DEPLOYMENT_MANIFEST=/run/trellis/deployments/mainnet.manifest.json
# DEPLOYMENT_VERIFICATION=/run/trellis/deployments/mainnet.verification.json

# ---- Chain monitor (profile "monitoring": scripts/monitor.ts --chain, scripts/monitor-chain.ts; MONITORING.md has every check) ----
# Read by the chain-monitor service only, which loads this file and then the optional monitor.env; the router ignores
# these names. Every value shown is the monitor's own default, so leaving a line as it is changes nothing. The monitor
# needs no secret: it reads public addresses and the chain. MONITOR_BASE_URL is set by the compose file (http://api:8787).
#
# Public addresses of the hot keys whose SOL the monitor watches. Settlement, anchorer and slasher come from the
# deployments record when these are empty; the router and facilitator relay addresses are only known from here
# (scripts/mainnet/role-keys.ts prints both lines).
MONITOR_ROUTER_ADDRESS=
MONITOR_FACILITATOR_RELAY_ADDRESS=
MONITOR_SETTLEMENT_ADDRESS=
MONITOR_SLASHER_ADDRESS=
# Memo mode: the anchorer whose memo lines are read for anchor.lag and anchor.memo_conflict. Empty: ANCHORER_ADDRESS
# above, else the deployments record.
MONITOR_ANCHORER_ADDRESS=
# SOL each key must hold (signer.<role>.sol), and the settlement wallet's USDC floor (settlement.usdc).
MONITOR_ROUTER_SOL_FLOOR=0.05
MONITOR_FACILITATOR_RELAY_SOL_FLOOR=0.05
MONITOR_SETTLEMENT_SOL_FLOOR=0.05
MONITOR_ANCHORER_SOL_FLOOR=0.05
MONITOR_SLASHER_SOL_FLOOR=0.02
MONITOR_SETTLEMENT_USDC_FLOOR=0
# rpc.health: the RPC's head may be this many seconds old.
MONITOR_RPC_MAX_HEAD_AGE_S=120
# build.profile simulates build_profile on every deployed program and needs one address that holds SOL to pay the
# simulated fee. Empty: any role key of the deployments record. Nothing is signed or sent.
MONITOR_SIMULATION_PAYER=
# pause.expiring: hours before a pause lapses (72 h after it was last set) at which the monitor reports it.
MONITOR_PAUSE_RENEW_WARN_HOURS=12
# proposal.expiring: hours before an applicable proposal expires (7 days after it becomes effective).
MONITOR_PROPOSAL_EXPIRY_WARN_HOURS=24
# limiter.rate: the outflow rate the credits limiter should carry, in bps of the vault per 24 h. Change it only when
# the authority changed the rate on purpose.
MONITOR_SETTLE_RATE_BPS=2000
# limiter.settle_headroom, limiter.refund_headroom: least share (percent) of the most an allowance can hold at once.
MONITOR_LIMITER_MIN_HEADROOM_PCT=10
# anchor.lag: the last receipt root may have closed this many hours ago; and how far back the roots are looked for.
MONITOR_ANCHOR_MAX_LAG_HOURS=3
MONITOR_ANCHOR_LOOKBACK_HOURS=168
# events.*: how far back the credits program's transactions are read, and the bounds on the work of one pass.
MONITOR_EVENTS_LOOKBACK_HOURS=6
MONITOR_EVENTS_MAX_SIGNATURES=200
MONITOR_EVENTS_MAX_TRANSACTIONS=60
# events.spent_root_delta: the largest spend one commit may add, in USDC and as a share (percent) of the vault. Set
# the first to a few times a day's real usage.
MONITOR_SPENT_DELTA_MAX_USDC=2500
MONITOR_SPENT_DELTA_MAX_VAULT_PCT=50
# events.settle_destination: where settle_to_host may pay. Token accounts, and wallets whose USDC accounts are allowed
# (comma or space separated). With neither and no MONITOR_DATABASE_URL, the first host payout fails the check: set one
# of the three before it.
MONITOR_SETTLE_ALLOWLIST=
MONITOR_SETTLE_ALLOWLIST_OWNERS=
# A PostgreSQL URL of a READ-ONLY role: payout addresses and spent roots are then read from the router's own tables,
# and credits.vault_covers_ledger can run. Since round 5 sanctions.fresh reads the list's age from here too (table
# sanctions_meta; the role needs SELECT on it) and FAILS without it, so in practice it is required. It carries a
# password: put it in monitor.env (gitignored), not here.
# MONITOR_DATABASE_URL=
# credits.vault_covers_ledger: how far (USDC) the vault may fall short of the ledger before the check fails.
MONITOR_LEDGER_TOLERANCE_USDC=1
# gateway.attestation: the provider id of the attested gateway and how old (minutes) its last verified attestation may be.
MONITOR_GATEWAY_PROVIDER=confidential-ai-gateway
MONITOR_ATTESTATION_MAX_AGE_MIN=30
