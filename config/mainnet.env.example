# Trellis on Solana mainnet-beta: the inputs of scripts/mainnet/* and the public values a router needs for mainnet.
# Public keys and public values only. Copy to .env.mainnet.local (gitignored by the `.env.*.local` rule) and load it
# into the shell that runs the scripts:   set -a; . ./.env.mainnet.local; set +a
# Nothing is deployed to mainnet yet: every address below is empty until the step of MAINNET.md that produces it.

# ---- 1. Deployment scripts (scripts/mainnet/README.md) ------------------------------------------------------------------
# The mainnet RPC URL from your RPC provider. It usually carries a key, so it is read from the environment only: there
# is no flag for it, it is never written to deployments/mainnet.json, it reaches no command line, and scripts print
# its host name only.
MAINNET_RPC_URL=
# Optional: a mainnet RPC endpoint WITHOUT a key (https and a host, nothing else), used only to publish the IDLs.
# `anchor idl init` puts its RPC URL on a command line, so the keyed URL above is never given to it. Unset: deploy.sh
# does not publish IDLs and records that.
# MAINNET_IDL_RPC_URL=https://api.mainnet-beta.solana.com
# The launch tier: which programs are deployed (MAINNET.md, "Launch tiers"; scripts/mainnet/tiers.ts).
#   minimal   none (pay-per-call x402; receipt roots as memo transactions)   <- the launch   about 0.2 SOL
#   credits   trellis_credits (prepaid credits): update 1 (UPDATES.md)                about 2.8 SOL
#   payments  + trellis_tab and trellis_anchor                                         about 7.4 SOL
#   full      all eight                                                                about 16.5 SOL
# Every script also takes --tier (or --programs a,b,c). A larger tier later deploys only what is missing.
MAINNET_TIER=minimal
# Path of the deployer keypair file (mode 0600), a key made for this deployment. It pays for the deploy and holds the
# upgrade authority and the config authority until the hand-over resolves (handover.ts: propose, 24 h, resolve). It is
# never the guardian and never a role key. The devnet deployer is refused.
MAINNET_DEPLOYER_KEYPAIR=
# Where scripts/mainnet/keys.sh keeps the fresh program keypairs (default ~/.config/trellis/mainnet/program-keys).
# TRELLIS_MAINNET_KEYS_DIR=
# Priority fee in micro-lamports per compute unit, and spare bytes reserved per program for later upgrades.
COMPUTE_UNIT_PRICE=5000
PROGRAM_HEADROOM_BYTES=0
# SOL each fee-paying role key is funded with (the preflight prints the list and what each address holds now), and the
# settlement commits a day the monthly cost is worked out for (1 = SETTLEMENT_INTERVAL_MS=86400000).
MAINNET_ROLE_FLOAT_SOL=0.1
MAINNET_SPENT_ROOTS_PER_DAY=1

# Role public keys init.ts writes into the configs. Generate each key yourself (MAINNET.md, "Keys"); only the public
# half belongs here. Every role needs its own key, and none may be the deployer key. A key the chosen tier does not
# need may stay empty (in brackets: what needs it).
# The Squads v4 VAULT address (not a member key, not the multisig account). It owns the treasury token accounts from
# the start and receives every authority at handover.
MAINNET_MULTISIG_VAULT=
# The Squads multisig account, for `handover.ts` and `verify.ts --expect multisig`. It is read from the chain and judged
# every time (propose, resolve, check, verify), against the four values below.
MAINNET_MULTISIG_ACCOUNT=
# The member keys of that multisig, comma separated. Required: the account on chain must hold exactly these members,
# each with every permission (initiate, vote, execute). `key:iv` names a member's permissions (letters of i, v, e).
MAINNET_MULTISIG_MEMBERS=
# Votes needed (never below 2), and which vault of the multisig holds the programs.
MAINNET_MULTISIG_THRESHOLD=2
MAINNET_MULTISIG_VAULT_INDEX=0
# Optional: the least time lock, in seconds, the multisig must carry (it is the only delay on a program upgrade, and
# must stay below 259200 so that a pause can still be renewed). Unset: the time lock is reported. A time lock of 0
# (upgrades take effect at once) is a FAIL since round 5 (R5-17) unless you acknowledge it in so many words:
# MAINNET_MULTISIG_ZERO_TIME_LOCK_ACK=upgrades-take-effect-at-once, which records it as an exception.
# MAINNET_MULTISIG_MIN_TIME_LOCK=
# MAINNET_MULTISIG_ZERO_TIME_LOCK_ACK=
# [credits, tab, bond, capacity, rules] The GUARDIAN: the key that can pause with one signature. A key of its own, set
# at init and left alone by the hand-over: not the deployer, not the multisig vault, not a worker key. Keep it on a
# hardware wallet or a machine that is not the production host. It can pause for 72 hours and nothing else: it cannot
# unpause, cannot renew, and cannot cancel a pending config proposal (only the authority cancels one). The hand-over
# never replaces it from this value: `handover.ts propose --set-guardian <key>` is the one way, and it shows both keys.
MAINNET_GUARDIAN=
# Optional: the guardian's keypair FILE (mode 0600), when it is a file key, so that `pause.ts` can send the pause
# itself. With a hardware wallet leave this empty and use `pause.ts --print --signer $MAINNET_GUARDIAN`. Without it
# `pause.ts` stops: it uses the deployer key only when told to (--as-authority).
# MAINNET_GUARDIAN_KEYPAIR=
# [credits] trellis_credits settlement_authority: the key of worker-settlement (SETTLEMENT_PRIVATE_KEY).
MAINNET_SETTLEMENT_AUTHORITY=
# [every tier that deploys a program: required] The anchorer: the key of worker-anchor (ANCHORER_PRIVATE_KEY). In memo mode (tiers without
# trellis_anchor) its signature is what makes the hourly memo line a root; with trellis_anchor it is that program's
# authority from init on. It posts every hour, so it is not the multisig.
MAINNET_ANCHORER=
# [bond] trellis_bond slasher: the key of worker-slasher (SLASHER_PRIVATE_KEY).
MAINNET_SLASHER=
# [anchor] The first receipt signing key (public half). The router makes and rotates its own receipt keys and the anchor worker
# publishes the current one within an hour of starting, replacing this one; keep this key's secret offline or destroy it.
MAINNET_RECEIPT_SIGNER=
# [fee_router] The $TRLS mint: Token-2022, no extensions, 9 decimals.
MAINNET_TRLS_MINT=
# [capacity] USDC per Bushel (1M output-equivalent tokens) for grades G-S, G-M, G-L, e.g. 1,2,4. The documents fix no number, so
# there is no default: trellis_capacity is initialised with what you set here (use `init.ts --pause-capacity` to keep
# sales closed until Bushels launch).
MAINNET_GRADE_PRICES_USDC=
# Optional. Defaults: the sale authority is the settlement key; the HVX authority is the multisig vault (nothing
# publishes HVX on chain at launch; name a key here only if HVX_PUBLISH_ONCHAIN will be on and a worker will hold it).
# MAINNET_SALE_AUTHORITY=
# MAINNET_HVX_AUTHORITY=

# ---- 2. Router values for mainnet (layer over .env.example; deploy/production/.env.production.example has the full set) ----
CHAIN_ID=101
SOLANA_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
X402_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
# Sponsored network fees (security review round 3). The router key pays the Solana fee of every x402 payment it co-signs
# and passes it on to the payer at cost, at this SOL price (USDC per SOL): set it to what you pay for the SOL you fund
# the key with. No margin is added; GET /api/v1/status shows lamports paid and USDC recovered side by side.
X402_SOL_USDC=250
# No per-call quote is below this (USDC); start-up fails unless it covers the worst-case fee three times at X402_SOL_USDC.
X402_MIN_PAYMENT=0.03
# The router key signs nothing below this balance, and spends at most these amounts on sponsored fees over any minute and
# any 24 hours (continuously refilled; a quarter is available at once).
X402_FEE_PAYER_FLOOR_LAMPORTS=50000000
X402_SPONSOR_LAMPORTS_PER_MIN=2000000
X402_SPONSOR_LAMPORTS_PER_DAY=500000000
X402_PAYER_LAMPORTS_PER_DAY=2000000
# The wallet-facing endpoint. The private RPC URL goes in SOL_RPC_URL in the deployment's own env file, never here.
PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
EXPLORER_URL=https://explorer.solana.com
SOLANA_COMMITMENT=confirmed
USDC_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
TRLS_TOKEN_SYMBOL=TRLS
TRLS_TOKEN_DECIMALS=9

# The launch tier, the anchor mode, the anchorer's public key, program ids, treasury and refund pool: printed by
# `bun scripts/mainnet/verify.ts --i-understand-this-is-mainnet --env` once the tier's programs are deployed and
# initialised. Empty until then; what the tier does not deploy stays empty.
LAUNCH_TIER=minimal
# The launch surface (src/surface/): core is the default and the launch. Only the allow-listed routes and jobs exist.
LAUNCH_SURFACE=core
ANCHOR_MODE=
ANCHORER_ADDRESS=
SETTLEMENT_INTERVAL_MS=86400000
TRELLIS_CREDITS_PROGRAM_ID=
TRELLIS_TAB_PROGRAM_ID=
TRELLIS_BOND_PROGRAM_ID=
TRELLIS_ANCHOR_PROGRAM_ID=
TRELLIS_RULES_PROGRAM_ID=
TRELLIS_FEE_ROUTER_PROGRAM_ID=
TRELLIS_CAPACITY_PROGRAM_ID=
TRELLIS_MEASUREMENTS_PROGRAM_ID=
TREASURY_ADDRESS=
REFUND_POOL_ADDRESS=

# The measurement registry and the HVX feed stay off chain at launch (deploy/production/.env.production.example says why).
MEASUREMENTS_ONCHAIN_SUBMIT=false
MEASUREMENT_AUTHORITY_ROLE=keeper
HVX_PUBLISH_ONCHAIN=false
HVX_AUTHORITY_ROLE=keeper

# Caps while the programs are unaudited, as init.ts sets them on chain (the router refuses higher values).
TAB_CAP_USDC=500
CREDITS_CAP_USDC=5000
CREDITS_REFUND_DELAY_H=72
# Zero markup: every fee setting is 0.
PER_CALL_MARGIN_BPS=0
PROVIDER_FEE_BPS=0
BYOK_FEE_BPS=0
FACILITATOR_FEE_BPS=0
FAUCET_ENABLED=false

# ---- 3. Monitoring floors (scripts/monitor.ts --once --cluster mainnet; MONITORING.md) -----------------------------------
# Public addresses of the keys the monitor watches, so a monitoring device needs no secret. Settlement, anchorer and
# slasher are read from deployments/mainnet.json; the router and facilitator relay addresses are set here.
# MONITOR_ROUTER_ADDRESS=
# MONITOR_FACILITATOR_RELAY_ADDRESS=
# MONITOR_SETTLEMENT_SOL_FLOOR=0.05
# MONITOR_ANCHORER_SOL_FLOOR=0.05
# MONITOR_SLASHER_SOL_FLOOR=0.02
# MONITOR_ROUTER_SOL_FLOOR=0.05
# MONITOR_FACILITATOR_RELAY_SOL_FLOOR=0.05
# MONITOR_SETTLEMENT_USDC_FLOOR=0
# MONITOR_ANCHOR_MAX_LAG_HOURS=3
# Memo mode: the anchorer address whose memo lines are read for anchor.lag and anchor.memo_conflict (default: the record).
# MONITOR_ANCHORER_ADDRESS=
