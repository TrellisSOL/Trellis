# Trellis router against the devnet deployment (scripts/devnet, deployments/devnet.json). Layer this over .env.example;
# the key names are those of src/config.ts. Public keys only: role secrets (SETTLEMENT_PRIVATE_KEY, ANCHORER_PRIVATE_KEY,
# SLASHER_PRIVATE_KEY, ROUTER_PRIVATE_KEY) are never written here. On devnet every program authority is the deployer key
# below; the receipt signing key's secret is in the gitignored deployments/devnet.secrets.json.

# ---- Cluster ---------------------------------------------------------------------------------------------------------
CHAIN_ID=103
SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOL_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com
SOL_RPC_FALLBACK_URLS=
# The wallet-facing endpoint. src/solana/rpc-config.ts treats SOL_RPC_URL as private unless it is one of the clusters' own
# public endpoints (api.mainnet-beta / api.devnet / api.testnet .solana.com), so on devnet it may be the same
# https://api.devnet.solana.com; Triton's public devnet endpoint answers without a key too.
PUBLIC_RPC_URL=https://api.devnet.solana.com
EXPLORER_URL=https://explorer.solana.com   # add ?cluster=devnet to explorer links
SOLANA_COMMITMENT=confirmed

# ---- Mints -----------------------------------------------------------------------------------------------------------
USDC_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   # Circle's devnet USDC (6 decimals)
# TRLS_TOKEN_ADDRESS=ECiMUNsKgXE35VqoRc1TkFF8Wjw5jjXEHX6W329waJVH   # Token-2022 test mint created by scripts/devnet/init.ts. Setting it
#   switches on $TRLS holder tiers (with HOLDER_TIERS) and TRLS escrow deposits. TRLS_POOL_LEGS (pools pricing TRLS in USDC) is
#   optional: without it TRLS deposits are not priced and wait as pending; devnet has no pools, so leave the legs off.
# TRLS_POOL_LEGS=[{"key":{"pool":"<pool>","base":"<TRLS mint>","quote":"<USDC mint>"},"sign":1}]   # only with real pools; must chain TRLS -> USDC
TRLS_TOKEN_SYMBOL=TRLS
TRLS_TOKEN_DECIMALS=9

# ---- Programs (Anchor.toml [programs.devnet]) -------------------------------------------------------------------------
TRELLIS_CREDITS_PROGRAM_ID=dtwL4NqHvvF2QAB84y9VjfNdkEUGw6NWbNWRtgjifAi
TRELLIS_ANCHOR_PROGRAM_ID=GAzh2GTSDpqcNcMX1iiCq5Dezx85fQLNXA7M1tS5BMjn
TRELLIS_RULES_PROGRAM_ID=GAsF9tHESV7vWxK7nNQy8S7nGtGxGVd4SHNBvSVCjYj5
TRELLIS_TAB_PROGRAM_ID=9ZmEvfrQrZuVXGc4PovskV83KNxVvpFpvSu3K6R9a9tL
TRELLIS_BOND_PROGRAM_ID=EEiEdi8PVvCALtEXpgReQb32R5bUGz29zfAeoh1Kc8Vo
TRELLIS_FEE_ROUTER_PROGRAM_ID=68siMcyf6bvCae4v4TJLkqjBoeM4GfJmTmNSZp8CFRAt
TRELLIS_CAPACITY_PROGRAM_ID=G4cDQ3duVPoSQunY1zRMyn1n7r1rsf7hh9J65iKPzYNy
HOST_BOND_ADDRESS=EEiEdi8PVvCALtEXpgReQb32R5bUGz29zfAeoh1Kc8Vo

# ---- Treasury and pools (USDC token accounts owned by the deployer) --------------------------------------------------
TREASURY_ADDRESS=21JgWaDMFFMfsBj8vy2TF6euDqYgDnvMFwEcf8TSehum                 # protocol treasury wallet (its USDC ATA is the treasury token account)
REFUND_POOL_ADDRESS=DZQkujtxVxRCSHeRZ9MvPqU6QXFVkZAnCVsnFTLCnWei           # where executed slashes land before affected callers are refunded

# ---- Caps and timings ----------------------------------------------------------------------------------------------------
# Caps are the spec §10 defaults, as initialised on chain.
TAB_CAP_USDC=500
CREDITS_CAP_USDC=5000
# DEVNET-ONLY timings. The devnet configs carry the short parameter set of scripts/devnet/profile.ts, set with each
# program's update_config and recorded in deployments/devnet.json (profile "devnet", devnetOverrides), so the paths that
# wait can be watched in minutes (scripts/demo/devnet-paths.ts):
#   trellis_credits  refund delay 180 s (spec 72 h), expiry grace 1 h (spec 30 d)
#   trellis_bond     minimum bond 2 USDC (spec 10,000), unbond 300 s (spec 14 d), dispute window 180 s (spec 72 h),
#                    dispute block 600 s (spec 7 d)
# Mainnet keeps the spec values: config/solana-mainnet.json and scripts/mainnet/** never read this set, and a production
# router refuses CREDITS_REFUND_DELAY_H below 72. The value below is the devnet refund delay in hours (180 s); the
# settlement job reads the real delay from the chain before it pays.
CREDITS_REFUND_DELAY_H=0.05

# ---- Authorities (public keys; all the deployer on devnet, a Squads 2-of-3 in production, which is also the guardian) -------------
DEVNET_DEPLOYER=21JgWaDMFFMfsBj8vy2TF6euDqYgDnvMFwEcf8TSehum                  # program upgrade authority, config authority, guardian, settlement, slasher, sale, HVX
DEVNET_RECEIPT_SIGNER=CTqsEmgfbT7SpfwNRBRNzNG1zLLSF7PdXYMqjP8aV7t      # trellis_anchor SignerSet.current_signer (public key)
# TAB_PAYEE= the payee tabs must name; leave empty to fall back to X402_PAY_TO, then the router signing key
# X402_PAY_TO= where per-call x402 payments go. scripts/demo/make-env.ts writes the router signing key's address into
#   .env.devnet (its USDC account is the one tab closes pay), which switches per-call payments on.
FAUCET_ENABLED=false

# ---- Agent identity (Solana Agent Registry, ERC-8004 port; needs AGENT_PROFILES_ENABLED) -----------------------------------
# AGENT_IDENTITY_ENABLED=true
# AGENT_REGISTRY_PROGRAM_ID=8oo4J9tBB3Hna1jRQ3rWvJjojqM5DYTDJo5cejUuJy3C   # the published devnet registry; empty = registration and on-chain feedback off

# ---- Attested gateway for the SEALED lane (scripts/demo/private-ai.ts; an aci/1 gateway, see src/providers/aci.ts) ---------
# Set PRIVATE_AI_BASE_URL in the environment or .env.devnet.
# Set PRIVATE_AI_ATTESTATION_URL only if the gateway uses a custom attestation path.
# PRIVATE_AI_API_KEY= the gateway API key, for the one paid call (--call). A secret: it goes in the gitignored .env.devnet only.
# The script verifies the gateway's TDX quote with ATTESTATION_VERIFIERS when set, else with tee-cloud (the TEE cloud's public
# quote verifier at TEE_CLOUD_VERIFIER_URL, no credentials) plus dcap / dstack / intel-ta when their settings are present.

# Measurement registry (trellis_measurements) on devnet
TRELLIS_MEASUREMENTS_PROGRAM_ID=4PzSbQpW3tGQJY676KNr6AwWY9WZ4feKZ1rx6JjtTgNY
MEASUREMENT_AUTHORITY_ROLE=anchorer
